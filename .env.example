# Copy to .env and adjust. Everything is optional – defaults run fully offline on SQLite.
SEED=42
# SQLite (default) or PostgreSQL, e.g. postgresql+psycopg2://supplysight:supplysight@localhost:5432/supplysight
DATABASE_URL=
JWT_SECRET=change-me-to-a-long-random-string
JWT_EXPIRY_MINUTES=480
# Optional LLM for generated prose and LLM text-to-SQL (copilot works offline without it)
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-flash
# Optional MLflow server for experiment tracking (local registry is always used for serving)
MLFLOW_TRACKING_URI=
# Dashboard -> API mode (leave empty to call services in-process)
SUPPLYSIGHT_API_URL=
APPROVAL_THRESHOLD_INR=500000
SQL_ROW_LIMIT=200
SQL_TIMEOUT_S=5
# Backends: auto picks the best installed option
SUPPLYSIGHT_NN_BACKEND=auto
SUPPLYSIGHT_GBM_BACKEND=auto
SUPPLYSIGHT_EMBEDDINGS=auto
